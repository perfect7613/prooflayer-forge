    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
