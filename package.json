    "clsx": "^2.1.1",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "lucide-react": "0.542.0",
    "math": "^0.1.0",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "pg": "8.16.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
